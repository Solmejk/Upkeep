QMainWindow, QWidget {
    background-color: #1a1a1a;
    color: #e8e8e8;
    font-size: 13px;
}
/* Dropdowns (and their popup lists) in pt, not px: with a px-only font
   QFont.pointSize() is -1, and QComboBox reuses it internally — Qt then
   warns "QFont::setPointSize: Point size <= 0". 10pt ≈ 13px. (Same issue
   as QToolButton below.) */
QComboBox, QComboBox QAbstractItemView {
    font-size: 10pt;
}

/* Sidebar container + all its children share this background */
QWidget#sidebar,
QWidget#sidebarHeader {
    background-color: #222222;
}

QLabel#sidebarAvatar {
    background-color: transparent;
    border: none;
    border-radius: 32px;
}

QLabel#sidebarUsername {
    color: #e8e8e8;
    font-size: 14px;
    font-weight: bold;
    background-color: transparent;
}

QListWidget#sidebarList {
    background-color: #222222;
    color: #e8e8e8;
    border: none;
    outline: 0;
}
QListWidget#sidebarList::item {
    padding: 12px 16px;
    border-left: 3px solid transparent;
}
QListWidget#sidebarList::item:selected {
    background-color: #2d2d2d;
    color: #e8a838;
    border-left: 3px solid #e8a838;
}
QListWidget#sidebarList::item:hover {
    background-color: #2d2d2d;
}

QPushButton {
    background-color: #e8a838;
    color: #1a1a1a;
    border: none;
    padding: 8px 16px;
    border-radius: 4px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #f5c46a;
}
QPushButton:pressed {
    background-color: #c48d28;
}

QFrame#statsFrame {
    background-color: #222222;
    border: 1px solid #2d2d2d;
    border-radius: 6px;
    padding: 12px;
}

QLabel {
    background-color: transparent;
    border: none;
    padding: 0;
}

QLabel#homeTitle {
    font-size: 24px;
    font-weight: bold;
    color: #e8a838;
}

QLabel#placeholderLabel {
    font-size: 18px;
    color: #888888;
}

QLabel#screenTitle {
    font-size: 24px;
    font-weight: bold;
    color: #e8a838;
    background-color: transparent;
}

QScrollArea#decksScroll,
QScrollArea#cardModalScroll {
    background-color: transparent;
    border: none;
}

QLabel#imageTilePicture {
    background-color: transparent;
    border: 2px solid transparent;
    border-radius: 14px;
}
QLabel#imageTilePicture:hover {
    border: 2px solid #e8a838;
}

QLabel#imageTileCaption {
    color: #e8e8e8;
    font-size: 12px;
    font-weight: bold;
    background-color: transparent;
    padding: 0 4px;
}

QLabel#deckDetailValue {
    font-size: 18px;
    color: #e8a838;
    background-color: transparent;
}

QLabel#deckSectionHeader {
    font-size: 16px;
    font-weight: bold;
    color: #e8e8e8;
    background-color: transparent;
    padding-top: 8px;
    border-bottom: 1px solid #2d2d2d;
    padding-bottom: 6px;
}

QLabel#activeLabel {
    color: #e8e8e8;
    font-weight: bold;
    background-color: transparent;
}

QLabel#filterLabel {
    color: #e8e8e8;
    font-weight: bold;
    background-color: transparent;
}

QPushButton#backButton {
    background-color: transparent;
    color: #e8a838;
    border: 1px solid #2d2d2d;
    padding: 6px 12px;
}
QPushButton#backButton:hover {
    background-color: #2d2d2d;
    border: 1px solid #e8a838;
}

QWidget#cardModal {
    background-color: rgba(0, 0, 0, 180);
}

QWidget#cardModalContent {
    background-color: #222222;
    border-radius: 12px;
    border: 1px solid #2d2d2d;
}

QLabel#cardModalName {
    font-size: 18px;
    font-weight: bold;
    color: #e8e8e8;
    background-color: transparent;
}

QLabel#cardModalMeta {
    font-size: 13px;
    color: #aaaaaa;
    background-color: transparent;
}

QLabel#collectionStats {
    color: #e8e8e8;
    font-size: 13px;
    background-color: transparent;
}

QLineEdit#searchInput {
    background-color: #2a2a2a;
    color: #e8e8e8;
    border: 1px solid #2d2d2d;
    border-radius: 4px;
    padding: 8px 12px;
    font-size: 13px;
}
QLineEdit#searchInput:focus {
    border: 1px solid #e8a838;
}

QPlainTextEdit#exportText, QPlainTextEdit#syncLogText {
    background-color: #2a2a2a;
    color: #e8e8e8;
    border: 1px solid #2d2d2d;
    border-radius: 4px;
    padding: 8px 12px;
    font-family: Consolas, monospace;
    font-size: 12px;
}

QLabel#resultCount {
    color: #888888;
    font-size: 12px;
    background-color: transparent;
    padding-right: 12px;
}

QToolButton {
    background-color: #2a2a2a;
    color: #e8e8e8;
    border: 1px solid #2d2d2d;
    border-radius: 4px;
    padding: 8px 16px;
    font-weight: bold;
    /* pt, not px — the stylesheet cascade always wins over a Python-set
       QFont once any QSS touches a widget (setFont() alone doesn't stick),
       and a px-only font leaves QFont.pointSize() at -1, which broke
       tooltip rendering ("QFont::setPointSize: Point size <= 0"). */
    font-size: 10pt;
}
QToolButton:hover {
    border: 1px solid #e8a838;
}
QToolButton:checked {
    background-color: #e8a838;
    color: #1a1a1a;
    border: 1px solid #e8a838;
}
QToolButton::menu-indicator {
    image: none;
    width: 0px;
}

QMenu {
    background-color: #222222;
    color: #e8e8e8;
    border: 1px solid #2d2d2d;
    padding: 4px;
}
QMenu::item {
    padding: 6px 12px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #2d2d2d;
}

QCheckBox {
    color: #e8e8e8;
    background-color: transparent;
    padding: 4px 8px;
}
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #2d2d2d;
    border-radius: 3px;
    background-color: #2a2a2a;
}
QCheckBox::indicator:checked {
    background-color: #e8a838;
    border: 1px solid #e8a838;
}
/* Radio buttons (e.g. the Game Tracker's winner) — round, orange when checked */
QRadioButton {
    color: #e8e8e8;
    spacing: 6px;
    background-color: transparent;
}
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #555555;
    border-radius: 8px;
    background-color: #2a2a2a;
}
QRadioButton::indicator:hover {
    border: 1px solid #e8a838;
}
QRadioButton::indicator:checked {
    background-color: #e8a838;
    border: 3px solid #2a2a2a;
    outline: 1px solid #e8a838;
}

QFrame#settingsSection {
    background-color: #222222;
    border: 1px solid #2d2d2d;
    border-radius: 6px;
}

QLabel#settingsSectionTitle {
    color: #e8a838;
    font-size: 15px;
    font-weight: bold;
    background-color: transparent;
}

QLabel#settingsDescription {
    color: #888888;
    font-size: 12px;
    background-color: transparent;
    padding-bottom: 4px;
}

QLabel#settingsLabel {
    color: #e8e8e8;
    font-size: 13px;
    background-color: transparent;
}

QTextBrowser#searchHelp {
    background-color: #222222;
    color: #e8e8e8;
    border: 1px solid #2d2d2d;
    border-radius: 6px;
    padding: 12px 20px;
    font-size: 13px;
}

QListWidget#deckList {
    background-color: #222222;
    color: #e8e8e8;
    border: 1px solid #2d2d2d;
    border-radius: 6px;
    padding: 6px;
    font-size: 13px;
    outline: 0;
}
QListWidget#deckList::item {
    padding: 2px 4px;
}
QListWidget#deckList::item:hover {
    background-color: #2d2d2d;
}
QListWidget#deckList::item:selected {
    background-color: #2d2d2d;
    color: #e8a838;
}

QSpinBox#basicLandCount {
    background-color: #2a2a2a;
    color: #e8e8e8;
    border: 1px solid #2d2d2d;
    border-radius: 4px;
    padding: 6px;
    font-size: 14px;
    qproperty-alignment: AlignCenter;
}
/* The − / + buttons are our own (stepButton), so the spin box's arrows are
   hidden here, at zero width. Not with setButtonSymbols(NoButtons): from
   Qt 6.12 a styled spin box with NoButtons squashes its text field to
   1 px, so only a sliver of the number shows. */
QSpinBox#basicLandCount::up-button,
QSpinBox#basicLandCount::down-button {
    width: 0px;
    border: none;
}
QPushButton#stepButton {
    background-color: #2a2a2a;
    color: #e8a838;
    border: 1px solid #2d2d2d;
    padding: 6px 0;
    font-size: 16px;
    font-weight: bold;
}
QPushButton#stepButton:hover {
    border: 1px solid #e8a838;
}

QPushButton#removeButton {
    background-color: transparent;
    color: #e8e8e8;
    border: 1px solid #2d2d2d;
    padding: 4px 0;
    font-size: 12px;
}
QPushButton#removeButton:hover {
    color: #e06c6c;
    border: 1px solid #e06c6c;
}

QLabel#resultCountAbove {
    color: #888888;
    font-size: 12px;
    background-color: transparent;
}

QLabel#chartTitle {
    color: #e8e8e8;
    font-size: 9pt;
    font-weight: bold;
    background-color: transparent;
}

QPushButton#languageWarning {
    background-color: transparent;
    color: #e8a838;
    border: none;
    padding: 2px 0;
    font-size: 13px;
    text-align: left;
}
QPushButton#languageWarning:hover {
    text-decoration: underline;
}
QPushButton#languageWarning[confirmed="true"] {
    color: #888888;
    font-weight: normal;
}

QListWidget#showcaseCards {
    background-color: transparent;
    border: none;
    outline: 0;
}
QListWidget#showcaseCards::item,
QListWidget#showcaseCards::item:hover,
QListWidget#showcaseCards::item:selected {
    background-color: transparent;
    border: none;
    padding: 0;
    margin: 0;
}

QPushButton#showcaseName {
    background-color: transparent;
    color: #e8e8e8;
    border: none;
    padding: 0;
    font-size: 18px;
    font-weight: bold;
    text-align: left;
}
QPushButton#showcaseName:hover {
    color: #e8a838;
    text-decoration: underline;
}
QPushButton#showcaseName[editing="true"],
QPushButton#showcaseName[editing="true"]:hover {
    color: #e8a838;
    text-decoration: none;
}

/* Stats tables (Game Tracker: Players / Decks) — a dark card like the
   settings sections: orange header, soft alternating rows, no grid. */
QTableWidget#statsTable {
    background-color: #222222;
    alternate-background-color: #262626;
    color: #e8e8e8;
    border: 1px solid #2d2d2d;
    border-radius: 6px;
    font-size: 13px;
    outline: 0;
}
QTableWidget#statsTable::item {
    padding: 0 10px;
    border: none;
}
QTableWidget#statsTable::item:hover {
    background-color: #2d2d2d;
}
QTableWidget#statsTable QHeaderView {
    background-color: transparent;
}
QTableWidget#statsTable QHeaderView::section {
    background-color: #1e1e1e;
    color: #e8a838;
    font-weight: bold;
    font-size: 12px;
    padding: 8px 10px;
    border: none;
    border-bottom: 1px solid #e8a838;
}
QTableWidget#statsTable QHeaderView::section:first {
    border-top-left-radius: 6px;
}
QTableWidget#statsTable QHeaderView::section:last {
    border-top-right-radius: 6px;
}
QTableWidget#statsTable QHeaderView::section:hover {
    color: #f0c060;
}
QTableWidget#statsTable QTableCornerButton::section {
    background-color: #1e1e1e;
    border: none;
}

/* Progress bars (the update download, ...) — the app's yellow, not
   Windows' default green */
QProgressBar {
    background-color: #2a2a2a;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    color: #e8e8e8;
    text-align: center;
    min-height: 18px;
}
QProgressBar::chunk {
    background-color: #e8a838;
    border-radius: 3px;
}

/* Sidebar sync progress (ui/sidebar.py set_progress) */
QLabel#syncStatusText {
    color: #9a9a9a;
    font-size: 11px;
    background: transparent;
}
QProgressBar#syncStatusBar {
    min-height: 6px;
    max-height: 6px;
    border: none;
    border-radius: 3px;
}
QProgressBar#syncStatusBar::chunk {
    border-radius: 3px;
}
